GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-3.7-flash
FIRESTORE_DATABASE=(default)
# firestore when GOOGLE_CLOUD_PROJECT is a real id; file for fully offline.
GREENCHAIN_STORE=firestore
MCP_URL=https://greenchain-mcp-jiwhxjcfia-uc.a.run.app
# Local FastMCP instead:
# MCP_URL=http://127.0.0.1:8081
# Firebase / GCS bucket for run artifacts (default: {project}.appspot.com)
# GREENCHAIN_ARTIFACT_BUCKET=
# Live Climatiq factors (required for production kgCO2e; fixture catalog is fallback only)
# CLIMATIQ_API_KEY=
# Optional generic factor HTTP instead of Climatiq
# GREENCHAIN_FACTOR_URL=
# GREENCHAIN_FACTOR_TOKEN=
# Live ERP activity API: GET ?company_id&year&region&run_id → { "rows": [...] }
# GREENCHAIN_ERP_URL=
# GREENCHAIN_ERP_TOKEN=
# Set GREENCHAIN_FORCE_DETERMINISTIC=1 to skip ADK even if Vertex is configured.
# GOOGLE_APPLICATION_CREDENTIALS=
